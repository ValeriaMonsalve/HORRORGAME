      m_Calls: []
  m_text: "Explore and Survive:\r\n\u2022\tSearch the rooms of the house looking
    for notes with ritual instructions while also searching for the items required
    for the ritual.\n\r\n\u2022\tManage your flashlight\u2019s power (collect batteries
    in drawers and cabinets).\n\r\n\u2022\tAvoid the line of sight of patrolling
    ghosts. If they detect you, aim and throw a holy water flask at them to scare
    them off or banish them.\r\n\nPerform the Ritual in the Attic:\r\n\u2022\tFollow
    the steps from the ritual note and place all the required items into the vessel.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: e73a58f6e2794ae7b1b7e50b7fb811b0, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
