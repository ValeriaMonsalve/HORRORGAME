  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Manage the Willpower Bar:\r\n\u2022\tYour time is limited; possession
    will gradually consume your willpower. If the bar reaches zero, you will die.\n\r\nExtreme
    Evasion:\r\n\u2022\tThe Devil patrols the limbo. Holy water is useless here;
    you must move with complete stealth and hide among the floating architecture.\n\r\nPuzzles
    and Sacred Keys:\r\n\u2022\tFind the Sacred Keys to purify/destroy the 3 relics
    and break the demonic pact.\n\r\nCounter-Ritual and Escape:\r\n\u2022\tReturn
    to the core of the Attic in the Netherworld and perform the final counter-ritual
    before your willpower runs out to expel the entity and return to real life.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
